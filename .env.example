# Iris AI Launcher - Environment Configuration
# Copy this file to .env and fill in your values

# AI Backend Selection: 'GEMINI' | 'GROQ' | 'NVIDIA' | 'OLLAMA' | 'HUGGINGFACE'
VITE_DEFAULT_LLM_BACKEND=GEMINI

# Google Gemini API Key
VITE_GEMINI_API_KEY=

# Groq API Key
VITE_GROQ_API_KEY=

# NVIDIA NIM API Key
VITE_NVIDIA_API_KEY=

# Hugging Face API Key
VITE_HUGGINGFACE_API_KEY=

# Cartesia TTS API Key (optional - for high-quality voice)
VITE_CARTESIA_API_KEY=

# Cartesia Voice ID (optional)
VITE_CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238

# Ollama endpoint (for local AI)
VITE_OLLAMA_ENDPOINT=http://localhost:11434

# Weather default city
VITE_DEFAULT_CITY=London
